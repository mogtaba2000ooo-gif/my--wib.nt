let currentFormStep = 1;

function nextStep(step) {
    document.querySelectorAll('.form-step').forEach(element => element.classList.remove('active'));
    document.querySelectorAll('.step').forEach(element => element.classList.remove('active'));

    document.getElementById(`step${step}`).classList.add('active');
    document.getElementById(`stepIndicator${step}`).classList.add('active');

    currentFormStep = step;

    if (step === 3) {
        generateSummary();
    }
}

function generateSummary() {
    const serviceType = document.querySelector('input[name="service_type"]:checked').value;
    const companySize = document.getElementById('companySize').value;
    const notes = document.getElementById('serviceNotes').value || 'لا توجد ملاحظات إضافية';

    const selectedAddons = [];
    document.querySelectorAll('input[name="addons"]:checked').forEach(checkbox => {
        selectedAddons.push(checkbox.value);
    });

    const addonsText = selectedAddons.length > 0 ? selectedAddons.join(', ') : 'لا يوجد';

    const summaryHTML = `
        <p><strong>نوع الخدمة:</strong> ${serviceType}</p>
        <p><strong>حجم المؤسسة:</strong> ${companySize}</p>
        <p><strong>المتطلبات الإضافية:</strong> ${addonsText}</p>
        <p><strong>ملاحظاتك:</strong> ${notes}</p>
    `;

    document.getElementById('summaryContent').innerHTML = summaryHTML;
}

function sendToWhatsApp() {
    const phoneNumber = "249114757644"; // رقم المهندس مجتبى
    
    const serviceType = document.querySelector('input[name="service_type"]:checked').value;
    const companySize = document.getElementById('companySize').value;
