    const selectedAddons = [];
    document.querySelectorAll('input[name="addons"]:checked').forEach(checkbox => {
        selectedAddons.push(checkbox.value);
    });

    const addonsText = selectedAddons.length > 0 ? selectedAddons.join(', ') : 'لا يوجد';

    let message = `مرحباً Network+ (المهندس mujtaba-dev)%0A%0A`;
    message += `أود إرسال طلب خدمة تفاعلي جديد عبر الموقع:%0A`;
    message += `📌 *نوع الخدمة:* ${serviceType}%0A`;
    message += `🏢 *حجم المؤسسة:* ${companySize}%0A`;
    message += `⚙️ *المتطلبات الإضافية:* ${addonsText}%0A`;
    message += `📝 *ملاحظات:* ${notes}%0A%0A`;
    message += `أرجو التواصل معي لمناقشة التفاصيل.`;

    const whatsappUrl = `https://wa.me/${phoneNumber}?text=${message}`;
    window.open(whatsappUrl, '_blank');
}
