:root {
    --primary-blue: #0f4c81;
    --dark-blue: #0b2b48;
    --navy-blue: #071a2d;
    --accent-cyan: #00d2ff;
    --teal-blue: #00a8cc;
    --light-bg: #f4f7fa;
    --white: #ffffff;
    --text-dark: #1e293b;
    --text-muted: #64748b;
    --whatsapp-green: #25d366;
    --border-color: #e2e8f0;
    --shadow: 0 10px 25px -5px rgba(15, 76, 129, 0.1);
    --transition: all 0.3s ease;
}

* { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Tajawal', sans-serif; }
body { background-color: var(--light-bg); color: var(--text-dark); direction: rtl; line-height: 1.6; }
.container { width: 90%; max-width: 1200px; margin: 0 auto; }
.section-padding { padding: 80px 0; }

.section-header { text-align: center; margin-bottom: 50px; }
.section-header h2 { font-size: 2.2rem; color: var(--dark-blue); margin-bottom: 10px; }
.section-header p { color: var(--text-muted); font-size: 1.1rem; }
.section-header .line { width: 80px; height: 4px; background: linear-gradient(90deg, var(--primary-blue), var(--accent-cyan)); margin: 15px auto 0; border-radius: 2px; }

/* Navbar */
.navbar { background-color: rgba(7, 26, 45, 0.95); backdrop-filter: blur(10px); position: fixed; top: 0; left: 0; width: 100%; z-index: 1000; padding: 15px 0; box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2); }
.nav-container { display: flex; justify-content: space-between; align-items: center; }
.logo { font-size: 1.8rem; font-weight: 800; color: var(--white); }
.logo span { color: var(--accent-cyan); }
.logo i { color: var(--accent-cyan); margin-left: 8px; }
.nav-links { display: flex; gap: 25px; }
.nav-links a { color: #d1d5db; text-decoration: none; font-size: 1rem; font-weight: 500; transition: var(--transition); display: flex; align-items: center; gap: 6px; }
.nav-links a:hover, .nav-links a.active { color: var(--accent-cyan); }
.mobile-menu-btn { display: none; color: var(--white); font-size: 1.5rem; cursor: pointer; }

/* Hero */
.hero-section { background: linear-gradient(135deg, var(--navy-blue) 0%, var(--primary-blue) 100%); color: var(--white); padding: 180px 0 120px; text-align: center; }
.badge { background-color: rgba(0, 210, 255, 0.15); color: var(--accent-cyan); padding: 6px 16px; border-radius: 20px; font-size: 0.9rem; font-weight: 700; border: 1px solid rgba(0, 210, 255, 0.3); display: inline-block; margin-bottom: 20px; }
.hero-content h1 { font-size: 3rem; font-weight: 800; margin-bottom: 20px; }
.hero-content p { font-size: 1.2rem; color: #cbd5e1; margin-bottom: 35px; }
.hero-btns { display: flex; gap: 15px; justify-content: center; flex-wrap: wrap; }

/* Buttons */
.btn { padding: 12px 28px; border-radius: 8px; text-decoration: none; font-weight: 700; font-size: 1rem; transition: var(--transition); cursor: pointer; border: none; display: inline-flex; align-items: center; gap: 8px; }
.btn-primary { background: linear-gradient(90deg, var(--accent-cyan), var(--teal-blue)); color: var(--navy-blue); }
.btn-primary:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(0, 210, 255, 0.4); }
.btn-whatsapp { background-color: var(--whatsapp-green); color: var(--white); }
.btn-whatsapp:hover { background-color: #1eb954; transform: translateY(-3px); }
.btn-secondary { background-color: #e2e8f0; color: var(--text-dark); }
.btn-outline { border: 2px solid var(--primary-blue); color: var(--primary-blue); background: transparent; }
.btn-outline:hover { background-color: var(--primary-blue); color: var(--white); }

/* About */
.about-section { background-color: var(--white); }
.about-grid { display: grid; grid-template-columns: 1fr 1.5fr; gap: 40px; align-items: center; }
.image-placeholder { width: 100%; height: 350px; background: linear-gradient(135deg, #e0f2fe, #bae6fd); border: 2px dashed var(--teal-blue); border-radius: 16px; display: flex; flex-direction: column; justify-content: center; align-items: center; color: var(--primary-blue); text-align: center; padding: 20px; }
.placeholder-icon { font-size: 4rem; margin-bottom: 15px; }
.about-text h3 { font-size: 1.8rem; color: var(--dark-blue); margin-bottom: 15px; }
.about-text .highlight { color: var(--primary-blue); }
.about-text .lead { font-size: 1.15rem; font-weight: 600; color: var(--primary-blue); margin-bottom: 15px; }
.founder-card { background-color: var(--light-bg); border-right: 4px solid var(--accent-cyan); padding: 20px; border-radius: 8px; margin-top: 20px; }
.founder-name { font-size: 1.4rem; font-weight: 800; color: var(--dark-blue); }
.future-info-box { margin-top: 15px; padding: 12px 15px; background-color: #f0f9ff; border: 1px rgba(0, 168, 204, 0.2) solid; border-radius: 6px; display: flex; align-items: center; gap: 10px; color: var(--teal-blue); font-size: 0.85rem; }

/* Interactive Form */
.interactive-form-wrapper { background-color: var(--white); padding: 40px; border-radius: 16px; box-shadow: var(--shadow); max-width: 900px; margin: 0 auto; }
.step-indicator { display: flex; justify-content: space-between; margin-bottom: 30px; border-bottom: 2px solid var(--border-color); padding-bottom: 15px; }
.step.active { color: var(--primary-blue); border-bottom: 3px solid var(--accent-cyan); padding-bottom: 12px; font-weight: bold; }
.form-step { display: none; }
.form-step.active { display: block; }
.service-options-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-bottom: 30px; }
.service-card { position: relative; cursor: pointer; }
.service-radio { position: absolute; opacity: 0; }
.card-content { border: 2px solid var(--border-color); padding: 25px; border-radius: 12px; text-align: center; transition: var(--transition); }
.card-content i { font-size: 2.5rem; color: var(--primary-blue); margin-bottom: 15px; }
.service-radio:checked + .card-content { border-color: var(--accent-cyan); background-color: #f0f9ff; }
.form-group { margin-bottom: 20px; }
.form-group label { display: block; font-weight: 700; margin-bottom: 8px; }
.form-control { width: 100%; padding: 12px; border: 1px solid var(--border-color); border-radius: 8px; }
.checkbox-group { display: flex; flex-direction: column; gap: 10px; }
.btn-group { display: flex; justify-content: space-between; margin-top: 30px; }
.summary-box { background-color: var(--light-bg); padding: 20px; border-radius: 8px; border-right: 4px solid var(--primary-blue); margin-bottom: 20px; }

/* Store */
.products-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 30px; }
.product-card { background-color: var(--white); border-radius: 12px; padding: 25px; box-shadow: var(--shadow); position: relative; display: flex; flex-direction: column; }
.product-tag { position: absolute; top: 15px; left: 15px; background-color: #e0f2fe; color: var(--primary-blue); font-size: 0.75rem; font-weight: 700; padding: 4px 10px; border-radius: 12px; }
.product-icon { font-size: 3rem; color: var(--primary-blue); text-align: center; margin: 20px 0; }
.product-desc { color: var(--text-muted); font-size: 0.9rem; margin-bottom: 20px; flex-grow: 1; }
.product-footer { display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--border-color); padding-top: 15px; }

/* Contact & Footer */
.contact-card { background: linear-gradient(135deg, var(--navy-blue), var(--primary-blue)); color: var(--white); padding: 50px; border-radius: 16px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; }
footer { background-color: var(--navy-blue); color: #94a3b8; padding: 25px 0; text-align: center; }

@media (max-width: 768px) {
    .nav-links { display: none; position: absolute; top: 100%; left: 0; width: 100%; background-color: var(--navy-blue); flex-direction: column; padding: 20px; }
    .nav-links.active { display: flex; }
    .mobile-menu-btn { display: block; }
    .about-grid { grid-template-columns: 1fr; }
}
